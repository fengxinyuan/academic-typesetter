# ==========================================
# Academic Typesetter 核心配置
# ==========================================

# 阿里云百炼 API 密钥 (默认推荐，兼容 Qwen-Plus / Qwen-Max)
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# MinerU 平台 Token (https://mineru.net/apiManage/token)
MINERU_TOKEN=your_mineru_token_here

# 可选：DeepSeek 或 OpenAI 兼容 API 密钥
# DEEPSEEK_API_KEY=your_deepseek_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_BASE_URL=https://api.openai.com/v1/chat/completions

# 可选：自定义无头浏览器执行路径 (系统会自动从 Windows 注册表和 PATH 检测，一般无需配置)
# BROWSER_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# 可选：自定义中文字体路径 (系统会自动检索 %WINDIR%\Fonts，一般无需配置)
# FONT_PATH=C:\Windows\Fonts\msyh.ttc

# 可选：并发线程数 (默认 5)
# MAX_WORKERS=5
